      },
      {
        "id": "config",
        "x": 80,
        "y": 254,
        "w": 340,
        "h": 62,
        "title": "Load the matched deployment profile",
        "body": [
          "Feature constants, versions and thresholds",
          "Restore RTC schedule, daily state and queue"
        ],
        "kind": "process",
        "tone": "normal"
      },
      {
        "id": "wake",
        "x": 80,
        "y": 340,
        "w": 340,
        "h": 62,
        "title": "Wake from RTC or pending retry",
        "body": [
          "Check current time and unsent state",
          "Measurement cadence is configurable"
        ],
        "kind": "process",
        "tone": "normal"
      },
      {
        "id": "due",
        "x": 80,
        "y": 428,
        "w": 340,
        "h": 84,
        "title": "Measurement due?",
        "body": [],
        "kind": "decision",
        "tone": "normal"
      },
      {
        "id": "power",
        "x": 80,
        "y": 547,
        "w": 340,
        "h": 62,
        "title": "Power one sensing chain",
        "body": [
          "One piezo disc + MCP6002 conditioning",
          "Enable ESP32 ADC / DMA"
        ],
        "kind": "process",
        "tone": "normal"
      },
      {
        "id": "capture",
        "x": 80,
        "y": 632,
        "w": 340,
        "h": 76,
        "title": "Acquire one streamed recording",
        "body": [
          "Example: 20.5 s at 8 kHz mono",
          "Stream with bounded / reused buffers",
          "Keep the acquisition timestamp"
        ],
        "kind": "process",
        "tone": "normal"
      },
      {
        "id": "valid",
        "x": 80,
        "y": 740,
        "w": 340,
        "h": 88,
        "title": "Acquisition valid?",
        "body": [
          "ADC / clipping / data checks"
        ],
        "kind": "decision",
        "tone": "normal"
      },
      {
        "id": "invalid",
        "x": 80,
        "y": 856,
        "w": 340,
        "h": 66,
        "title": "Record an invalid measurement",
        "body": [
          "Increment quality / acquisition counters",
          "Do not classify an invalid capture as healthy"
        ],
        "kind": "process",
        "tone": "error"
      },
      {
        "id": "to_a",
        "x": 493,
        "y": 770,
        "w": 28,
