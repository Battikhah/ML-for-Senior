      },
      {
        "id": "to_c2",
        "x": 493,
        "y": 905,
        "w": 28,
        "h": 28,
        "title": "C",
        "body": [],
        "kind": "connector",
        "tone": "normal"
      },
      {
        "id": "from_a",
        "x": 786,
        "y": 190,
        "w": 28,
        "h": 28,
        "title": "A",
        "body": [],
        "kind": "connector",
        "tone": "normal"
      },
      {
        "id": "windows",
        "x": 630,
        "y": 246,
        "w": 340,
        "h": 76,
        "title": "Select the temporal windows",
        "body": [
          "10 s windows, 5 s stride + final tail",
          "20.5 s example: 0, 5, 10, 10.5 s",
          "Reset this recording's maximum score"
        ],
        "kind": "process",
        "tone": "normal"
      },
      {
        "id": "filter",
        "x": 630,
        "y": 350,
        "w": 340,
        "h": 76,
        "title": "Filter and measure signal quality",
        "body": [
          "Bandpass: 100-2500 Hz",
          "100 ms energy / burst statistics",
          "Energy variation is not an RPW decision"
        ],
        "kind": "process",
        "tone": "normal"
      },
      {
        "id": "mfcc",
        "x": 630,
        "y": 455,
        "w": 340,
        "h": 76,
        "title": "Extract and normalize MFCCs",
        "body": [
          "30 frames x 13 coefficients = 390 values",
          "Apply frozen training mean / scale",
          "Match the validated frontend exactly"
        ],
        "kind": "process",
        "tone": "normal"
      },
      {
        "id": "compute",
        "x": 630,
        "y": 560,
        "w": 340,
        "h": 76,
        "title": "Run the local INT8 residual CNN",
        "body": [
          "Quantize inputs with export scale / zero",
          "Run the saved 55,864-byte model",
          "Dequantize the output logit"
        ],
        "kind": "process",
        "tone": "accent"
      },
      {
        "id": "window_result",
        "x": 630,
        "y": 665,
        "w": 340,
        "h": 76,
        "title": "Update the recording RPW score",
        "body": [
          "Apply sigmoid to the window logit",
          "Record score = maximum window score",
          "Release / reuse temporary tensors"
        ],
        "kind": "process",
        "tone": "normal"
      },
      {
        "id": "more",
        "x": 630,
        "y": 770,
        "w": 340,
        "h": 82,
        "title": "More windows?",
        "body": [],
        "kind": "decision",
        "tone": "normal"
      },
      {
        "id": "finish",
        "x": 630,
        "y": 880,
        "w": 340,
        "h": 76,
        "title": "Apply the saved recording threshold",
        "body": [
          "RPW or healthy from the maximum score",
          "Update valid / RPW / healthy counters",
          "Retain max score and quality statistics"
        ],
        "kind": "process",
        "tone": "accent"
      },
      {
        "id": "to_c3",
        "x": 786,
        "y": 982,
