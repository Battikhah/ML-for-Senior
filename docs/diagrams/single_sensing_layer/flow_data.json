      },
      {
        "id": "from_c",
        "x": 1336,
        "y": 190,
        "w": 28,
        "h": 28,
        "title": "C",
        "body": [],
        "kind": "connector",
        "tone": "normal"
      },
      {
        "id": "state",
        "x": 1180,
        "y": 246,
        "w": 340,
        "h": 76,
        "title": "Persist daily state",
        "body": [
          "Measurement and validity / RPW counters",
          "Max score, battery and quality / fault flags",
          "Retain unacknowledged prior days"
        ],
        "kind": "process",
        "tone": "normal"
      },
      {
        "id": "report_due",
        "x": 1180,
        "y": 350,
        "w": 340,
        "h": 90,
        "title": "Report or retry due?",
        "body": [
          "At least one report each day"
        ],
        "kind": "decision",
        "tone": "normal"
      },
      {
        "id": "body",
        "x": 1180,
        "y": 475,
        "w": 340,
        "h": 88,
        "title": "Build the daily result summary",
        "body": [
          "Proposed 24-byte application body",
          "ID / day, counts, scores, battery / status",
          "Report even when no measurement is valid"
        ],
        "kind": "process",
        "tone": "normal"
      },
      {
        "id": "budget",
        "x": 1180,
        "y": 592,
        "w": 340,
        "h": 76,
        "title": "Queue the packet before radio TX",
        "body": [
          "Use sequence and schema / model version",
          "Keep totals until acknowledgement",
          "Transport / integrity metadata is extra"
        ],
        "kind": "process",
        "tone": "normal"
      },
      {
        "id": "tx",
        "x": 1180,
        "y": 712,
        "w": 340,
        "h": 76,
        "title": "Transmit using RFM95W LoRa",
        "body": [
          "Use the configured channel / SF / BW",
          "Apply the planned TX slot / backoff",
          "Gateway relays; queued data survives failure"
        ],
        "kind": "process",
        "tone": "accent"
      },
      {
        "id": "ack",
        "x": 1180,
        "y": 822,
        "w": 340,
        "h": 82,
        "title": "Application ACK received?",
        "body": [],
        "kind": "decision",
        "tone": "normal"
      },
      {
        "id": "retry",
        "x": 992,
        "y": 822,
        "w": 150,
        "h": 94,
        "title": "Delivery pending",
        "body": [
          "Bounded retries",
          "Backoff / retry later",
          "Persist until ACK",
          "Mark report overdue"
        ],
        "kind": "process",
        "tone": "warning"
      },
      {
        "id": "sleep",
        "x": 1180,
        "y": 928,
        "w": 340,
        "h": 82,
        "title": "Commit acknowledged state",
        "body": [
          "Clear acknowledged items / totals only",
          "Queue pending: schedule immediate TX wake",
          "Else sleep until next sample / retry"
        ],
        "kind": "terminator",
        "tone": "normal"
      },
      {
        "id": "endpoint",
        "x": 80,
        "y": 1070,
        "w": 1440,
        "h": 92,
        "title": "EXTERNAL ENDPOINT ONLY - gateway relay and result storage",
        "body": [
          "Gateway: validate / buffer the LoRa packet and forward over Wi-Fi or cellular.",
          "Server: deduplicate by node / day / sequence, store daily results and update dashboard / RPW alerts.",
          "No server acoustic classifier is required for this route; the node already made the recording-level decisions."
        ],
        "kind": "external",
        "tone": "normal"
      }
    ],
