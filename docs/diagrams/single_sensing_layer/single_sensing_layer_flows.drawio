        <mxCell id="label_0" value="Server-side classification: one sensing layer" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=31;fontStyle=1;fontColor=#173641;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="46" y="21" width="1480" height="41" />
        </mxCell>
        <mxCell id="label_1" value="ONE piezo sensor + ONE ESP32-WROOM32 + ONE RFM95W link. Temporal windows are not extra sensing layers." style="text;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#667b86;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="47" y="72" width="1480" height="26" />
        </mxCell>
        <mxCell id="label_2" value="1  WAKE AND ACQUIRE" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#2869a9;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="141" width="1480" height="28" />
        </mxCell>
        <mxCell id="label_3" value="2  PROCESS THE WINDOWS" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#2869a9;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="630" y="141" width="1480" height="28" />
        </mxCell>
        <mxCell id="label_4" value="3  REPORT AND DELIVER" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#2869a9;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="141" width="1480" height="28" />
        </mxCell>
        <mxCell id="label_5" value="Current evaluated classifier route: four windows for a 20.5 s recording. Five-window delta packing is a payload experiment, not a revalidated classifier." style="text;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#667b86;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="47" y="1177" width="1480" height="23" />
        </mxCell>
        <mxCell id="label_6" value="64 B refers to a feature-block target. Node/time identifiers, fragment headers, integrity/security and radio framing consume additional bytes." style="text;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#667b86;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="47" y="1201" width="1480" height="23" />
        </mxCell>
        <mxCell id="label_7" value="Daily reporting remains required even after rejected captures. The energy-variation proxy is a quality statistic, not proof of RPW activity." style="text;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#667b86;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="47" y="1225" width="1480" height="23" />
        </mxCell>
