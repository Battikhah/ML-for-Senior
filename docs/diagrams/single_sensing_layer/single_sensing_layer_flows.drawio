        <mxCell id="edge_30" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#54717c;fontSize=12;exitX=1;exitY=0.5;entryX=1;entryY=0.5;dashed=1;" edge="1" source="tx" target="endpoint" parent="1">
