        <mxCell id="config" value="&lt;b&gt;Load the matched deployment profile&lt;/b&gt;&lt;br&gt;Feature constants, versions and thresholds&lt;br&gt;Restore RTC schedule, daily state and queue" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
