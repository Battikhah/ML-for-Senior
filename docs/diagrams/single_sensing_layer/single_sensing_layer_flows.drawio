        </mxCell>
        <mxCell id="from_c" value="&lt;b&gt;C&lt;/b&gt;" style="shape=ellipse;rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1336" y="190" width="28" height="28" />
        </mxCell>
        <mxCell id="state" value="&lt;b&gt;Persist daily state&lt;/b&gt;&lt;br&gt;Measurement and validity / RPW counters&lt;br&gt;Max score, battery and quality / fault flags&lt;br&gt;Retain unacknowledged prior days" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="246" width="340" height="76" />
        </mxCell>
        <mxCell id="report_due" value="&lt;b&gt;Report or retry due?&lt;/b&gt;&lt;br&gt;At least one report each day" style="shape=rhombus;rounded=0;whiteSpace=wrap;html=1;fillColor=#fff6df;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="350" width="340" height="90" />
        </mxCell>
        <mxCell id="body" value="&lt;b&gt;Build the daily result summary&lt;/b&gt;&lt;br&gt;Proposed 24-byte application body&lt;br&gt;ID / day, counts, scores, battery / status&lt;br&gt;Report even when no measurement is valid" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="475" width="340" height="88" />
        </mxCell>
        <mxCell id="budget" value="&lt;b&gt;Queue the packet before radio TX&lt;/b&gt;&lt;br&gt;Use sequence and schema / model version&lt;br&gt;Keep totals until acknowledgement&lt;br&gt;Transport / integrity metadata is extra" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="592" width="340" height="76" />
        </mxCell>
        <mxCell id="tx" value="&lt;b&gt;Transmit using RFM95W LoRa&lt;/b&gt;&lt;br&gt;Use the configured channel / SF / BW&lt;br&gt;Apply the planned TX slot / backoff&lt;br&gt;Gateway relays; queued data survives failure" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5f1;strokeColor=#007f73;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="712" width="340" height="76" />
        </mxCell>
        <mxCell id="ack" value="&lt;b&gt;Application ACK received?&lt;/b&gt;" style="shape=rhombus;rounded=0;whiteSpace=wrap;html=1;fillColor=#fff6df;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="822" width="340" height="82" />
        </mxCell>
        <mxCell id="retry" value="&lt;b&gt;Delivery pending&lt;/b&gt;&lt;br&gt;Bounded retries&lt;br&gt;Backoff / retry later&lt;br&gt;Persist until ACK&lt;br&gt;Mark report overdue" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#fff6e8;strokeColor=#ba8b41;fontColor=#173641;fontFamily=Arial;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="992" y="822" width="150" height="94" />
        </mxCell>
        <mxCell id="sleep" value="&lt;b&gt;Commit acknowledged state&lt;/b&gt;&lt;br&gt;Clear acknowledged items / totals only&lt;br&gt;Queue pending: schedule immediate TX wake&lt;br&gt;Else sleep until next sample / retry" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="928" width="340" height="82" />
        </mxCell>
        <mxCell id="endpoint" value="&lt;b&gt;EXTERNAL ENDPOINT ONLY - gateway relay and result storage&lt;/b&gt;&lt;br&gt;Gateway: validate / buffer the LoRa packet and forward over Wi-Fi or cellular.&lt;br&gt;Server: deduplicate by node / day / sequence, store daily results and update dashboard / RPW alerts.&lt;br&gt;No server acoustic classifier is required for this route; the node already made the recording-level decisions." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f7f9;strokeColor=#c8d8dd;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
