        <mxCell id="edge_29" value="Next scheduled wake" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#54717c;fontSize=12;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" source="sleep" target="wake" parent="1">
