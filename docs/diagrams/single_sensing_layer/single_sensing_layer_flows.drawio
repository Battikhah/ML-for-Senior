        <mxCell id="from_a" value="&lt;b&gt;A&lt;/b&gt;" style="shape=ellipse;rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="786" y="190" width="28" height="28" />
        </mxCell>
        <mxCell id="windows" value="&lt;b&gt;Select the temporal windows&lt;/b&gt;&lt;br&gt;10 s windows, 5 s stride + final tail&lt;br&gt;20.5 s example: 0, 5, 10, 10.5 s&lt;br&gt;Reset this recording's maximum score" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="630" y="246" width="340" height="76" />
        </mxCell>
        <mxCell id="filter" value="&lt;b&gt;Filter and measure signal quality&lt;/b&gt;&lt;br&gt;Bandpass: 100-2500 Hz&lt;br&gt;100 ms energy / burst statistics&lt;br&gt;Energy variation is not an RPW decision" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="630" y="350" width="340" height="76" />
        </mxCell>
        <mxCell id="mfcc" value="&lt;b&gt;Extract and normalize MFCCs&lt;/b&gt;&lt;br&gt;30 frames x 13 coefficients = 390 values&lt;br&gt;Apply frozen training mean / scale&lt;br&gt;Match the validated frontend exactly" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="630" y="455" width="340" height="76" />
        </mxCell>
        <mxCell id="compute" value="&lt;b&gt;Run the local INT8 residual CNN&lt;/b&gt;&lt;br&gt;Quantize inputs with export scale / zero&lt;br&gt;Run the saved 55,864-byte model&lt;br&gt;Dequantize the output logit" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5f1;strokeColor=#007f73;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="630" y="560" width="340" height="76" />
        </mxCell>
        <mxCell id="window_result" value="&lt;b&gt;Update the recording RPW score&lt;/b&gt;&lt;br&gt;Apply sigmoid to the window logit&lt;br&gt;Record score = maximum window score&lt;br&gt;Release / reuse temporary tensors" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="630" y="665" width="340" height="76" />
        </mxCell>
        <mxCell id="more" value="&lt;b&gt;More windows?&lt;/b&gt;" style="shape=rhombus;rounded=0;whiteSpace=wrap;html=1;fillColor=#fff6df;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="630" y="770" width="340" height="82" />
        </mxCell>
        <mxCell id="finish" value="&lt;b&gt;Apply the saved recording threshold&lt;/b&gt;&lt;br&gt;RPW or healthy from the maximum score&lt;br&gt;Update valid / RPW / healthy counters&lt;br&gt;Retain max score and quality statistics" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5f1;strokeColor=#007f73;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
