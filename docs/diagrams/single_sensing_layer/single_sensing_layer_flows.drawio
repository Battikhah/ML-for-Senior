        <mxCell id="label_0" value="Local classification: one sensing layer" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=31;fontStyle=1;fontColor=#173641;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="46" y="21" width="1480" height="41" />
        </mxCell>
        <mxCell id="label_1" value="ONE piezo sensor + ONE ESP32-WROOM32 + ONE RFM95W link. Temporal windows are not extra sensing layers." style="text;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#667b86;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="47" y="72" width="1480" height="26" />
        </mxCell>
        <mxCell id="label_2" value="1  WAKE AND ACQUIRE" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#007f73;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="141" width="1480" height="28" />
        </mxCell>
        <mxCell id="label_3" value="2  PROCESS THE WINDOWS" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#007f73;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="630" y="141" width="1480" height="28" />
        </mxCell>
        <mxCell id="label_4" value="3  REPORT AND DELIVER" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#007f73;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="141" width="1480" height="28" />
        </mxCell>
        <mxCell id="label_5" value="The 24-byte daily summary is a proposed body, not a measured complete radio frame. Reporting schedule and ACK/retry protocol require firmware implementation." style="text;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#667b86;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="47" y="1177" width="1480" height="23" />
        </mxCell>
        <mxCell id="label_6" value="Local model is an INT8 deployment candidate. Feature parity, contiguous RAM, inference timing and energy must be measured on the actual ESP32." style="text;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#667b86;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="47" y="1201" width="1480" height="23" />
        </mxCell>
        <mxCell id="label_7" value="Daily reporting remains required even after rejected captures. The energy-variation proxy is a quality statistic, not proof of RPW activity." style="text;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#667b86;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="47" y="1225" width="1480" height="23" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Server PCA16" id="server">
    <mxGraphModel page="1" pageScale="1" pageWidth="1600" pageHeight="1260">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="scope_boundary" value="" style="rounded=1;fillColor=none;strokeColor=#c8d8dd;dashed=1;arcSize=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="34" y="118" width="1532" height="920" />
        </mxCell>
        <mxCell id="start" value="&lt;b&gt;BOOT / INITIALIZE&lt;/b&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="190" width="340" height="44" />
        </mxCell>
        <mxCell id="config" value="&lt;b&gt;Load the matched deployment profile&lt;/b&gt;&lt;br&gt;Feature constants, versions and thresholds&lt;br&gt;Restore RTC schedule, daily state and queue" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="254" width="340" height="62" />
        </mxCell>
        <mxCell id="wake" value="&lt;b&gt;Wake from RTC or pending retry&lt;/b&gt;&lt;br&gt;Check current time and unsent state&lt;br&gt;Measurement cadence is configurable" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="340" width="340" height="62" />
        </mxCell>
        <mxCell id="due" value="&lt;b&gt;Measurement due?&lt;/b&gt;" style="shape=rhombus;rounded=0;whiteSpace=wrap;html=1;fillColor=#fff6df;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="428" width="340" height="84" />
        </mxCell>
        <mxCell id="power" value="&lt;b&gt;Power one sensing chain&lt;/b&gt;&lt;br&gt;One piezo disc + MCP6002 conditioning&lt;br&gt;Enable ESP32 ADC / DMA" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="547" width="340" height="62" />
        </mxCell>
        <mxCell id="capture" value="&lt;b&gt;Acquire one streamed recording&lt;/b&gt;&lt;br&gt;Example: 20.5 s at 8 kHz mono&lt;br&gt;Stream with bounded / reused buffers&lt;br&gt;Keep the acquisition timestamp" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="632" width="340" height="76" />
        </mxCell>
        <mxCell id="valid" value="&lt;b&gt;Acquisition valid?&lt;/b&gt;&lt;br&gt;ADC / clipping / data checks" style="shape=rhombus;rounded=0;whiteSpace=wrap;html=1;fillColor=#fff6df;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="740" width="340" height="88" />
        </mxCell>
        <mxCell id="invalid" value="&lt;b&gt;Record an invalid measurement&lt;/b&gt;&lt;br&gt;Increment quality / acquisition counters&lt;br&gt;Do not classify an invalid capture as healthy" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ec;strokeColor=#ad5b46;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="856" width="340" height="66" />
        </mxCell>
        <mxCell id="to_a" value="&lt;b&gt;A&lt;/b&gt;" style="shape=ellipse;rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="493" y="770" width="28" height="28" />
        </mxCell>
        <mxCell id="to_c1" value="&lt;b&gt;C&lt;/b&gt;" style="shape=ellipse;rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="493" y="456" width="28" height="28" />
        </mxCell>
        <mxCell id="to_c2" value="&lt;b&gt;C&lt;/b&gt;" style="shape=ellipse;rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="493" y="905" width="28" height="28" />
        </mxCell>
        <mxCell id="from_a" value="&lt;b&gt;A&lt;/b&gt;" style="shape=ellipse;rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="786" y="190" width="28" height="28" />
        </mxCell>
        <mxCell id="windows" value="&lt;b&gt;Select the temporal windows&lt;/b&gt;&lt;br&gt;10 s windows, 5 s stride + final tail&lt;br&gt;20.5 s example: 0, 5, 10, 10.5 s&lt;br&gt;Initialize ordered window-vector list" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="630" y="246" width="340" height="76" />
        </mxCell>
        <mxCell id="filter" value="&lt;b&gt;Filter and measure signal quality&lt;/b&gt;&lt;br&gt;Bandpass: 100-2500 Hz&lt;br&gt;100 ms energy / burst statistics&lt;br&gt;Energy variation is not an RPW decision" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="630" y="350" width="340" height="76" />
        </mxCell>
        <mxCell id="mfcc" value="&lt;b&gt;Extract and normalize MFCCs&lt;/b&gt;&lt;br&gt;30 frames x 13 coefficients = 390 values&lt;br&gt;Apply frozen training mean / scale&lt;br&gt;Match the validated frontend exactly" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="630" y="455" width="340" height="76" />
        </mxCell>
        <mxCell id="compute" value="&lt;b&gt;Project into PCA16 coordinates&lt;/b&gt;&lt;br&gt;Subtract the frozen PCA training mean&lt;br&gt;Apply the learned 16 x 390 projection&lt;br&gt;No classifier runs on this sensing node" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#edf4fb;strokeColor=#2869a9;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="630" y="560" width="340" height="76" />
        </mxCell>
        <mxCell id="window_result" value="&lt;b&gt;Encode one 16-byte window vector&lt;/b&gt;&lt;br&gt;Round / clamp using training-fitted ranges&lt;br&gt;16 components, one byte per component&lt;br&gt;Retain profile ID and window order" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="630" y="665" width="340" height="76" />
        </mxCell>
        <mxCell id="more" value="&lt;b&gt;More windows?&lt;/b&gt;" style="shape=rhombus;rounded=0;whiteSpace=wrap;html=1;fillColor=#fff6df;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="630" y="770" width="340" height="82" />
        </mxCell>
        <mxCell id="finish" value="&lt;b&gt;Losslessly pack the window vectors&lt;/b&gt;&lt;br&gt;First vector + delta / Rice codes + escapes&lt;br&gt;Keep the shortest encoding or raw fallback&lt;br&gt;No additional PCA precision is discarded" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#edf4fb;strokeColor=#2869a9;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="630" y="880" width="340" height="76" />
        </mxCell>
        <mxCell id="to_c3" value="&lt;b&gt;C&lt;/b&gt;" style="shape=ellipse;rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="786" y="982" width="28" height="28" />
        </mxCell>
        <mxCell id="from_c" value="&lt;b&gt;C&lt;/b&gt;" style="shape=ellipse;rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1336" y="190" width="28" height="28" />
        </mxCell>
        <mxCell id="state" value="&lt;b&gt;Persist features and health state&lt;/b&gt;&lt;br&gt;Keep each complete measurement record&lt;br&gt;Node / record / window / profile identifiers&lt;br&gt;No RPW label is generated here" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="246" width="340" height="76" />
        </mxCell>
        <mxCell id="report_due" value="&lt;b&gt;Transmit due?&lt;/b&gt;&lt;br&gt;Sample / daily / retry deadline" style="shape=rhombus;rounded=0;whiteSpace=wrap;html=1;fillColor=#fff6df;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="350" width="340" height="90" />
        </mxCell>
        <mxCell id="body" value="&lt;b&gt;Build the feature / status report&lt;/b&gt;&lt;br&gt;Drain retained records at least daily&lt;br&gt;Multiple packets may be required&lt;br&gt;Send heartbeat even with no valid capture" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="475" width="340" height="88" />
        </mxCell>
        <mxCell id="budget" value="&lt;b&gt;Feature block fits budget?&lt;/b&gt;&lt;br&gt;64 B feature-block target" style="shape=rhombus;rounded=0;whiteSpace=wrap;html=1;fillColor=#fff6df;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="592" width="340" height="82" />
        </mxCell>
        <mxCell id="fragment" value="&lt;b&gt;If oversized&lt;/b&gt;&lt;br&gt;Fragment the record&lt;br&gt;Keep index + total&lt;br&gt;Preserve all windows&lt;br&gt;Do not silently drop" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#fff6e8;strokeColor=#ba8b41;fontColor=#173641;fontFamily=Arial;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="992" y="590" width="150" height="104" />
        </mxCell>
        <mxCell id="tx" value="&lt;b&gt;Transmit using RFM95W LoRa&lt;/b&gt;&lt;br&gt;Use the configured channel / SF / BW&lt;br&gt;Apply the planned TX slot / backoff&lt;br&gt;Gateway relays; queued data survives failure" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#edf4fb;strokeColor=#2869a9;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="712" width="340" height="76" />
        </mxCell>
        <mxCell id="ack" value="&lt;b&gt;Application ACK received?&lt;/b&gt;" style="shape=rhombus;rounded=0;whiteSpace=wrap;html=1;fillColor=#fff6df;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="822" width="340" height="82" />
        </mxCell>
        <mxCell id="retry" value="&lt;b&gt;Delivery pending&lt;/b&gt;&lt;br&gt;Bounded retries&lt;br&gt;Backoff / retry later&lt;br&gt;Persist until ACK&lt;br&gt;Mark report overdue" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#fff6e8;strokeColor=#ba8b41;fontColor=#173641;fontFamily=Arial;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="992" y="822" width="150" height="94" />
        </mxCell>
        <mxCell id="sleep" value="&lt;b&gt;Commit acknowledged state&lt;/b&gt;&lt;br&gt;Clear acknowledged items / totals only&lt;br&gt;Queue pending: schedule immediate TX wake&lt;br&gt;Else sleep until next sample / retry" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#54717c;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="928" width="340" height="82" />
        </mxCell>
        <mxCell id="endpoint" value="&lt;b&gt;EXTERNAL ENDPOINT ONLY - gateway relay and server classification&lt;/b&gt;&lt;br&gt;Gateway: validate / buffer / forward over Wi-Fi or cellular; no RPW inference at the gateway.&lt;br&gt;Server: check profile/version, reassemble fragments, unpack deltas, dequantize PCA16 and apply inverse PCA.&lt;br&gt;Reshape to normalized 30 x 13 MFCCs (do not normalize twice); classify windows, take maximum score, apply saved threshold, store / alert." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f7f9;strokeColor=#c8d8dd;fontColor=#173641;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="1070" width="1440" height="92" />
        </mxCell>
        <mxCell id="edge_0" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#54717c;fontSize=12;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="start" target="config" parent="1">
          <mxGeometry as="geometry" relative="1">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#54717c;fontSize=12;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="config" target="wake" parent="1">
          <mxGeometry as="geometry" relative="1">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#54717c;fontSize=12;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="wake" target="due" parent="1">
          <mxGeometry as="geometry" relative="1">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_3" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#54717c;fontSize=12;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="due" target="power" parent="1">
          <mxGeometry as="geometry" relative="1">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_4" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#54717c;fontSize=12;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="due" target="to_c1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <Array as="points" />
